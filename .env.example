# Chatbox Configuration

# ===== OLLAMA CONFIGURATION =====
# Ollama Server URL - defaults to localhost:11434
# Change this if Ollama is running on a different host/port
OLLAMA_URL=http://localhost:11434

# Ollama Model to use
# Options: llama2, mistral, neural-chat, dolphin-mixtral, etc.
OLLAMA_MODEL=llama2

# ===== WEATHER API CONFIGURATION =====
# Get a free API key from: https://openweathermap.org/api
# (Free tier allows 1000 calls/day)
WEATHER_API_KEY=YOUR_API_KEY_HERE

# OpenWeatherMap API Endpoint (usually don't need to change)
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ===== BACKEND SERVER CONFIGURATION =====
# Port on which Spring Boot server will run
BACKEND_PORT=8080

# ===== FRONTEND CONFIGURATION =====
# Port on which Angular dev server will run
FRONTEND_PORT=4200

# Backend API URL (used by frontend to connect to backend)
BACKEND_API_URL=http://localhost:8080

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ===== OPTIONAL: PROXY/FIREWALL =====
# If running behind a proxy, configure here:
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8443
